---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SemesterSection from "../../components/SemesterSection.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve weeks, twelve forensic methods, one dig site — grouped into the four phases the semester moves through."
  {...siteConfig}
>
  <p>
    Every week is a method, not a topic. You bring the same dig site to all
    twelve, and each one gives you a different way to read it — so the findings
    accumulate rather than reset. Weeks 1–4 establish what the thing is; 5–8
    work out why it died; 9–11 ask whether it should come back; week 12 is
    where you tell someone.
  </p>
  <p>
    Each {sessionLabels.singular.toLowerCase()} page carries three things: what
    to do before you arrive, what happens in the room, and what leaves with
    you.
  </p>
  <SemesterSection />
</ContentLayout>
